{
  "name": "matter-tools-reanimated",
  "version": "0.4.0",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "dev": "node ./scripts/dev.js",
    "dev:android": "node ./scripts/dev.js --android",
    "dev:ios": "node ./scripts/dev.js --ios",
    "dev:web": "node ./scripts/dev.js --web",
    "start": "yarn dev",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build": "bob build"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.0.0-next.4",
    "matter-js-reanimated": "*",
    "react-native-reanimated": "~3.17.4",
    "react-native-svg": "^15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.3.12",
    "@react-navigation/native": "^7.1.8",
    "@types/jest": "^29.5.12",
    "@types/matter-js": "^0.19.8",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^18.3.0",
    "cross-env": "^7.0.3",
    "expo": "53.0.9",
    "expo-blur": "~14.1.4",
    "expo-constants": "~17.1.6",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.0.7",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.4",
    "expo-system-ui": "~5.0.7",
    "expo-web-browser": "~14.1.6",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.5",
    "matter-js": "^0.20.0",
    "react-native-builder-bob": "^0.23.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": false
    },
    "react-native-svg": {
      "optional": false
    },
    "react-native-gesture-handler": {
      "optional": false
    },
    "@shopify/react-native-skia": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {}
      ],
      [
        "typescript",
        {
          "tsc": "../../node_modules/.bin/tsc",
          "project": "./tsconfig.build.json"
        }
      ]
    ]
  },
  "private": false
}
